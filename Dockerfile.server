# syntax=docker/dockerfile:1
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

# BuildKit cache mounts: package downloads persist under the docker data-root,
# so rebuilds (after code changes) only hit the network for NEW packages.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl docker.io ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt

# Pre-download Piper voice model (baked into image)
RUN python -m piper --help > /dev/null 2>&1; \
    mkdir -p /models/piper && \
    echo "warmup" | python -m piper --model en_US-lessac-medium \
      --data-dir /models/piper --output-raw > /dev/null 2>&1 || true

COPY server/ ./server/
COPY call_session.py audio.py prompts.py tts_common.py tts_piper.py tts_kokoro.py tts_chatterbox.py ./
COPY static/ ./static/
COPY payers/ ./payers/

RUN mkdir -p /models/chatterbox/voices

# Build-time version stamp — see GIT_COMMIT/BUILD_TIME in docker-compose.yml's
# build.args, set by rebuild.sh from the actual working tree being built.
# This is what /api/config surfaces in the Settings page: the only reliable
# way to confirm "the code I just changed is actually what's running" is to
# have the running app report its own build identity, since `docker restart`
# silently keeps serving the OLD baked-in image if you forgot `--build`.
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME

EXPOSE 8080

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
