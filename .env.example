# Copy to .env on the VM and fill in. .env is gitignored and host-specific —
# NEVER rsync/scp it from a local checkout (sync.sh hard-excludes it on
# purpose; see the comment there). If you need to change a value, SSH in
# and edit /home/azureuser/ar-voice-agent/.env directly.
#
# After changing anything here, the voice-agent container must be
# RECREATED to pick it up — `docker compose --profile prod up -d
# voice-agent` (no --build needed for env-only changes; add --build if
# code also changed). A plain `docker restart` does NOT reread .env.

# ── Twilio (telephony) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567

# ── Public URL this VM is served at ──────────────────────────────────
# Must exactly match the domain Caddy has a cached TLS cert for (see
# `docker run --rm -v ar-voice-agent_caddy-data:/data alpine find
# /data/caddy/certificates -maxdepth 2` to check what's cached). Getting
# this wrong doesn't just break routing — it makes Caddy try to obtain a
# NEW cert for the wrong domain, which fails behind the NSG firewall and
# takes HTTPS down entirely. This has happened once already.
PUBLIC_DOMAIN=call3.ar-voice.com
PUBLIC_SCHEME=https

# ── LLM (vLLM) ────────────────────────────────────────────────────────
LLM_MODEL=hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4
# HF_TOKEN=              # only needed for gated HuggingFace models

# ── Opik (LLM tracing/eval UI) ───────────────────────────────────────
# Opik runs as its OWN docker-compose stack (/opt/opik), not this one, on
# a different network. voice-agent cannot resolve the "opik-backend"
# hostname (that's an internal name inside Opik's own stack) — it has to
# reach Opik through whatever container from Opik's stack is ALSO
# attached to this project's default network. Confirm with:
#   docker network inspect ar-voice-agent_default \
#     --format '{{range .Containers}}{{.Name}} {{end}}'
# As of this writing that's opik-frontend-1 on port 5173, which serves
# both the UI and a /api/is-alive/ping health check the app polls at
# startup — hence the non-obvious port (5173, not opik-backend's 8080)
# below. If Opik's stack is ever redeployed and container names change,
# re-derive this the same way rather than assuming it's still correct.
OPIK_ENABLED=1
OPIK_BASE_URL=http://opik-frontend-1:5173
# OPIK_API_KEY=          # not needed for the local/self-hosted instance

# ── NOT set here ──────────────────────────────────────────────────────
# GIT_COMMIT / BUILD_TIME are build ARGs (docker-compose.yml's
# build.args), not runtime env vars — sync.sh sets them automatically
# from the local git repo on every deploy. Setting them in .env would do
# nothing (Dockerfile ARGs aren't read from env_file).
