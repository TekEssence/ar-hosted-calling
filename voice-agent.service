[Unit]
Description=AR Voice Agent Server
After=cloud-final.service docker.service network-online.target hybrid-storage.service
Wants=network-online.target cloud-final.service
Requires=docker.service hybrid-storage.service
StartLimitIntervalSec=0

# Activated by voice-agent-recovery.timer after Azure/cloud-init preparation.
# Do not enable under multi-user.target: cloud-final starts after that target.
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ar-voice-agent/deploy
ExecStart=/bin/bash /opt/ar-voice-agent/deploy/start.sh
# Preserve containers and volumes across VM shutdown.
ExecStop=/usr/bin/docker compose --project-name ar-voice-agent --profile prod --profile tls stop --timeout 60
Environment=COMPOSE_PROJECT_NAME=ar-voice-agent
TimeoutStartSec=0
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
EnvironmentFile=-/opt/ar-voice-agent/deploy/.hybrid.env
EnvironmentFile=-/opt/ar-voice-agent/deploy/.hybrid-images.env
User=azureuser
